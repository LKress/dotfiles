
" Basic Vim configuration

" Syntax highlighting
syntax on

" Show line numbers
set number

" Use spaces instead of tabs
set expandtab
set tabstop=4
set shiftwidth=4

" Enable smart indentation
set autoindent
set smartindent

" Search settings
set ignorecase
set smartcase
set incsearch
set hlsearch

" Better display
set showcmd
set wildmenu

" Enable mouse support
set mouse=a

" Use UTF-8 encoding
set encoding=utf-8

" Disable backup and swap files
set nobackup
set noswapfile

" Use a readable color scheme
set background=dark

